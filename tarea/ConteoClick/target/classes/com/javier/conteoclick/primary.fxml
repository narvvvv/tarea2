<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="550.0" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javier.conteoclick.ConteoClick">
   <children>
      <Label layoutX="210.0" layoutY="60.0" text="Contar número de clicks" />
      <TextField fx:id="txtContador" editable="false" layoutX="75.0" layoutY="95.0" prefWidth="400.0" text="0" />
      <Button fx:id="btnContar" layoutX="235.0" layoutY="150.0" mnemonicParsing="false" onAction="#Contar" text="¡Contar!" />
      <Label layoutX="225.0" layoutY="240.0" text="Esperar 10 segundos" />
      <ProgressBar fx:id="progressBar" layoutX="75.0" layoutY="280.0" prefHeight="25.0" prefWidth="400.0" progress="0.0" />
      <Button fx:id="btnEsperar" layoutX="235.0" layoutY="340.0" mnemonicParsing="false" onAction="#Esperar" text="¡Esperar!" />
   </children>
</AnchorPane>